# =============================================================================
# KnowledgeDock environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:
#
#     cp .env.sample .env
#
# How it works:
#   The app reads configuration through python-decouple's AutoConfig, which
#   looks for a `.env` file in the working directory and falls back to real
#   process environment variables. That means:
#     - Local dev:    edit `.env` (git-ignored, never commit secrets)
#     - Production:   inject the same variables into the host environment
#                     (e.g. Render dashboard) — no `.env` file needed
#
# Variables marked REQUIRED below have no default: the app refuses to start
# without them. Everything else falls back to the shown default.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# REQUIRED. Runtime environment label, e.g. development, staging, production.
# Controls production-only behavior such as hiding the interactive API docs.
ENVIRONMENT=development

# Port the Uvicorn server binds to. Optional, defaults to 8000.
# Note: platforms like Render inject their own PORT at runtime, which
# overrides this value.
PORT=8000


# -----------------------------------------------------------------------------
# Authentication & security
# -----------------------------------------------------------------------------

# REQUIRED. Secret key used to sign JWT authentication tokens.
# Generate a strong random value, e.g.:  openssl rand -hex 32
# Never commit the real value to git.
SECRET_KEY=

# How long an issued login token stays valid, in minutes. Default 60.
JWT_EXPIRE_MINUTES=60

# Minimum password length enforced at registration. Default 8.
PASSWORD_MIN_LENGTH=8

# How long a password-reset link stays usable, in minutes. Default 30.
# Only the SHA-256 digest of a reset token is stored, and MongoDB purges
# expired ones via a TTL index.
PASSWORD_RESET_EXPIRE_MINUTES=30


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------

# REQUIRED. Connection string for MongoDB (local or Atlas).
# Local example:  mongodb://localhost:27017
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside MongoDB. Default "knowledgedock".
MONGODB_DB=knowledgedock

# How long the driver waits to select a server before giving up, in
# milliseconds. Lower fails faster on bad networks; higher tolerates slow
# connections. Default 8000.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000


# -----------------------------------------------------------------------------
# AI provider (Gemini)
# -----------------------------------------------------------------------------

# REQUIRED. Provider selector for the AI abstraction layer. Currently: gemini.
AI_PROVIDER=gemini

# REQUIRED. Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for answer generation (chat). Default gemini-3.8-flash.
# Must stay on the free tier: Gemini's Pro series became paid-only in 2026,
# Flash / Flash-Lite are the free models. Confirm the exact model id and your
# live quota at https://aistudio.google.com  -> Dashboard -> Usage.
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Sampling temperature for generation: 0.0 = deterministic and factual
# (recommended for grounded Q&A), higher = more creative. Default 0.0.
GEMINI_TEMPERATURE=0.0

# Hard cap on tokens the model may generate per answer. Default 800.
GEMINI_MAX_OUTPUT_TOKENS=800

# Model used to turn text into embedding vectors. Default gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Dimensionality of the produced embedding vectors. Must match the model
# above and the vector index configuration. Default 768.
GEMINI_EMBEDDING_DIMENSIONS=768

# REQUIRED. Embedding task type for stored document chunks — tells the model
# the text is a document to be retrieved later. Keep RETRIEVAL_DOCUMENT.
GEMINI_EMBEDDING_TASK_DOCUMENT=RETRIEVAL_DOCUMENT

# REQUIRED. Embedding task type for user queries — tells the model the text is
# a search query. Keep RETRIEVAL_QUERY.
GEMINI_EMBEDDING_TASK_QUERY=RETRIEVAL_QUERY

# Maximum text length (tokens) sent per embedding request. Default 1800.
GEMINI_EMBEDDING_MAX_INPUT_TOKENS=1800

# Timeout for a single AI provider call, in seconds. Default 30.
AI_TIMEOUT_SECONDS=30

# How many times a failed AI call is retried before giving up. Default 3.
AI_MAX_RETRIES=3

# Base delay for exponential backoff with full jitter between provider retries,
# in seconds. Default 1.0. Jitter matters: without it every request that failed
# together retries together and reproduces the burst that caused the failure.
AI_RETRY_BACKOFF_SECONDS=1.0


# -----------------------------------------------------------------------------
# File storage & upload validation
# -----------------------------------------------------------------------------

# Directory where uploaded files are stored on local disk. The path is
# created on startup if missing. Default /tmp/knowledgedock/uploads.
STORAGE_DIR=/tmp/knowledgedock/uploads

# Maximum accepted upload size in megabytes. Default 10.
MAX_UPLOAD_SIZE_MB=10

# Comma-separated MIME types the upload endpoint accepts. Anything outside
# this list is rejected with a 415/400 error.
ALLOWED_CONTENT_TYPES=text/plain,text/markdown,text/html,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document


# -----------------------------------------------------------------------------
# Document chunking (ingestion)
# -----------------------------------------------------------------------------

# Target size of each text chunk, in characters. Smaller chunks = more
# precise retrieval but more embeddings. Default 1000.
CHUNK_SIZE=1000

# How many characters consecutive chunks overlap, so context is not lost at
# chunk boundaries. Default 200.
CHUNK_OVERLAP=200

# Chunks smaller than this (after splitting) are discarded as noise
# (headings, blank lines). Default 100.
MIN_CHUNK_SIZE=100


# -----------------------------------------------------------------------------
# Vector search & retrieval
# -----------------------------------------------------------------------------

# Name of the MongoDB vector search index on the document_chunks collection.
# Must match the index created in your database. Default vector_index.
VECTOR_INDEX_NAME=vector_index

# Similarity metric used by the vector index: cosine, euclidean, or dotProduct.
# Must match how the index was built. Default cosine.
VECTOR_SIMILARITY=cosine

# How many top-matching chunks are retrieved per question. Default 5.
RETRIEVAL_TOP_K=5

# Minimum similarity score (0.0-1.0) for a chunk to count as relevant.
# Below this, the app answers "I couldn't find enough information" instead
# of guessing. Default 0.35.
RETRIEVAL_MIN_SCORE=0.35

# Maximum total characters of retrieved context injected into the LLM prompt,
# keeping answers grounded and within token limits. Default 6000.
CONTEXT_MAX_CHARS=6000


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# Max API requests per minute per user across general endpoints. Default 60.
RATE_LIMIT_PER_MINUTE=60

# Max requests per minute per user on the query endpoint (AI calls are
# expensive, so this is stricter). Default 10.
RATE_LIMIT_QUERY_PER_MINUTE=10


# -----------------------------------------------------------------------------
# Background processing
# -----------------------------------------------------------------------------

# How many times a failed document processing job is retried before the
# document is marked FAILED. Default 3.
PROCESSING_MAX_ATTEMPTS=3

# A document still PROCESSING when the process starts was interrupted, usually by
# the free tier spinning down mid-job. Those are returned to PENDING at startup,
# as are FAILED documents with attempts left. Default 30.
PROCESSING_STALE_AFTER_MINUTES=30

# How often the worker polls for PENDING documents, in seconds. This is the
# latency between an upload and its first processing attempt. Default 10.
PROCESSING_POLL_INTERVAL_SECONDS=10

# Set false only where ingestion cannot run (e.g. a read-only replica).
PROCESSING_ENABLED=true


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Default INFO.
LOG_LEVEL=INFO
