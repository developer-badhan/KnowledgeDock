# =============================================================================
# KnowledgeDock — Environment Variable Sample
# =============================================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.sample .env
#
# NEVER commit `.env`. Only `.env.sample` belongs in git.
# Never hard-code these values in source code.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=KnowledgeDock
APP_ENV=development                 # development | staging | production
APP_DEBUG=true                      # NEVER true in production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0

# Comma-separated list, e.g. http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# Trust X-Forwarded-* headers (enable only behind a reverse proxy)
TRUSTED_PROXY_HEADERS=false

# Public base URL of the app (used in links/emails)
PUBLIC_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-value

# Salt/pepper used with the password hasher (argon2id)
PASSWORD_HASH_SALT=change-me

# Argon2id parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536          # KiB
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32

# JWT settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=knowledgedock
JWT_AUDIENCE=knowledgedock-api

# Minimum acceptable password length
PASSWORD_MIN_LENGTH=8


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=knowledgedock

# Optional: override credentials separately if using a managed cluster
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Connection pool / timeouts (milliseconds)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000

# Set to true when TLS is enabled (Atlas / managed clusters)
MONGO_TLS_ENABLED=false

# Bootstrap admin user created on first startup when DB is empty.
# Change the password before any real use; leave empty to disable bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_WORKSPACE=Default Workspace


# -----------------------------------------------------------------------------
# AI Provider — selection
# -----------------------------------------------------------------------------
# openai | gemini | ollama (local) | null  (null = deterministic fake provider
# useful for tests and for running the app without any AI credentials)
AI_PROVIDER=null

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_SECONDS=1.0
AI_RETRY_MAX_BACKOFF_SECONDS=8.0


# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MAX_BATCH_SIZE=100
EMBEDDING_MAX_TOKENS_PER_REQUEST=250000


# -----------------------------------------------------------------------------
# LLM (chat / answer generation)
# -----------------------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_INPUT_TOKENS=12000


# -----------------------------------------------------------------------------
# OpenAI credentials
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=


# -----------------------------------------------------------------------------
# Gemini / Google AI credentials
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# -----------------------------------------------------------------------------
# Ollama (local models, optional)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# Document upload / storage
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local              # local | s3
STORAGE_LOCAL_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_CONTENT_TYPES=text/plain,text/markdown,text/html,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ALLOWED_EXTENSIONS=.txt,.md,.markdown,.html,.htm,.pdf,.docx


# -----------------------------------------------------------------------------
# Chunking (ingestion)
# -----------------------------------------------------------------------------
CHUNK_SIZE=1000                    # characters
CHUNK_OVERLAP=200                  # characters
MIN_CHUNK_SIZE=100                 # discard chunks smaller than this
CHUNK_STRATEGY=recursive_character # recursive_character | token


# -----------------------------------------------------------------------------
# Retrieval / Vector Search
# -----------------------------------------------------------------------------
# Vector index name on the document_chunks collection
VECTOR_INDEX_NAME=vector_index
# Must match EMBEDDING_DIMENSIONS
VECTOR_DIMENSIONS=1536
# Atlas Vector Search similarity metric
VECTOR_SIMILARITY=cosine

# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=5
# Maximum characters of context handed to the LLM
CONTEXT_MAX_CHARS=6000
# Minimum similarity score required to answer. Below this → no-answer fallback.
RETRIEVAL_MIN_SCORE=0.35


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# inprocess (default, no extra infra) | redis
RATE_LIMIT_BACKEND=inprocess
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_QUERY_REQUESTS_PER_MINUTE=10
RATE_LIMIT_UPLOAD_REQUESTS_PER_MINUTE=20

# Only needed when RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Background processing
# -----------------------------------------------------------------------------
# inprocess (FastAPI BackgroundTasks) | worker (separate process)
WORKER_BACKEND=inprocess
MAX_CONCURRENT_PROCESSING_JOBS=2
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_DELAY_SECONDS=5
# Stale PROCESSING documents older than this are considered abandoned
PROCESSING_STALE_AFTER_MINUTES=30


# -----------------------------------------------------------------------------
# Logging / Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                    # json | console
LOG_FILE=
# Log S3-style document body content (leave false to avoid leaking data)
LOG_DOCUMENT_CONTENT=false
ENABLE_REQUEST_LOGGING=true


# -----------------------------------------------------------------------------
# Frontend / CORS helpers
# -----------------------------------------------------------------------------
FRONTEND_TITLE=KnowledgeDock
FRONTEND_THEME=default


# -----------------------------------------------------------------------------
# Docker Compose (used when running via docker compose)
# -----------------------------------------------------------------------------
MONGO_CONTAINER_PORT=27017
API_CONTAINER_PORT=8000
APP_CONTAINER_PORT=8000