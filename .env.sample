# =============================================================================
# KnowledgeDock — Environment Variable Sample
# =============================================================================
# Copy to `.env` and fill in:
#     cp .env.sample .env
#
# Deployment target: Render (free web service) + MongoDB Atlas (free M0 cluster).
#
# Rules:
#   * NEVER commit `.env`. Only this `.env.sample` belongs in git.
#   * Never hard-code these values in source code.
#   * Only variables marked REQUIRED must be set to boot the app.
#   * CORS / ALLOWED_HOSTS are intentionally absent: the UI is server-rendered
#     by FastAPI (Jinja2 + Bootstrap CDN + HTMX CDN + vanilla JS), so the
#     browser always talks to the same origin. No CORS configuration needed.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=production               # production | development
DEBUG=false                          # true only locally; never in production

# Render injects PORT automatically (defaults to 10000 on Render).
# The app MUST bind 0.0.0.0, not localhost.
PORT=8000
HOST=0.0.0.0


# -----------------------------------------------------------------------------
# Security  (REQUIRED)
# -----------------------------------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates all issued JWTs.
SECRET_KEY=                                         # REQUIRED

# Password hashing — argon2id.
# Memory cost is kept low because Render's free tier has 512 MB RAM.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=19456                            # KiB (19 MB, OWASP minimum)
ARGON2_PARALLELISM=2
PASSWORD_MIN_LENGTH=8

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=knowledgedock

# Optional first-run bootstrap account, created only when the users
# collection is empty. Leave both blank to disable bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Database — MongoDB Atlas  (REQUIRED)
# -----------------------------------------------------------------------------
# Atlas: Atlas UI → Connect → Drivers → Python → copy the SRV string.
# Atlas already forces TLS, so no TLS flag is needed.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net   # REQUIRED
MONGODB_DB=knowledgedock

MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_CONNECT_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# AI reliability (shared by chat + embeddings)
# -----------------------------------------------------------------------------
AI_TIMEOUT_SECONDS=30                # hard timeout on every outbound AI call
AI_MAX_RETRIES=3                     # bounded retries with exponential backoff
AI_RETRY_BACKOFF_SECONDS=1.0


# -----------------------------------------------------------------------------
# AI provider selection  (REQUIRED)
# -----------------------------------------------------------------------------
# openai | gemini | null
#   null = deterministic fake provider, for tests and credential-free local runs.
AI_PROVIDER=openai                   # REQUIRED

OPENAI_API_KEY=                      # REQUIRED when AI_PROVIDER=openai
# Only change for OpenAI-compatible gateways.
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=                      # REQUIRED when AI_PROVIDER=gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Changing the model REQUIRES rebuilding the Atlas vector index:
#   EMBEDDING_DIMENSIONS must equal the model's output size.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=96


# -----------------------------------------------------------------------------
# LLM (answer generation)
# -----------------------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0                  # 0.0 for grounded, deterministic answers
LLM_MAX_OUTPUT_TOKENS=800


# -----------------------------------------------------------------------------
# Document upload
# -----------------------------------------------------------------------------
# Render's filesystem is ephemeral: uploaded files vanish on redeploy/spin-down.
# This is acceptable because the extracted text and vectors live in MongoDB —
# the raw upload is only needed during processing. Use a persistent mount or
# object storage if originals must survive.
STORAGE_DIR=/tmp/knowledgedock/uploads

MAX_UPLOAD_SIZE_MB=10
ALLOWED_CONTENT_TYPES=text/plain,text/markdown,text/html,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document


# -----------------------------------------------------------------------------
# Chunking (ingestion)
# -----------------------------------------------------------------------------
CHUNK_SIZE=1000                      # characters
CHUNK_OVERLAP=200                    # characters
MIN_CHUNK_SIZE=100                   # drop fragments smaller than this


# -----------------------------------------------------------------------------
# Retrieval / Atlas Vector Search
# -----------------------------------------------------------------------------
VECTOR_INDEX_NAME=vector_index
VECTOR_SIMILARITY=cosine

RETRIEVAL_TOP_K=5
# Below this score → no-answer fallback instead of calling the LLM.
RETRIEVAL_MIN_SCORE=0.35
# Character budget for the context handed to the LLM.
CONTEXT_MAX_CHARS=6000


# -----------------------------------------------------------------------------
# Rate limiting (in-process; no external service on the free tier)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60             # all authenticated endpoints
RATE_LIMIT_QUERY_PER_MINUTE=10       # /query is AI-billed and slower


# -----------------------------------------------------------------------------
# Background processing
# -----------------------------------------------------------------------------
# Render free tier runs a single web service with no separate worker and no
# always-on process, so processing runs in-process and resumes on wake.
PROCESSING_MAX_ATTEMPTS=3
# A document stuck in PROCESSING longer than this is treated as abandoned
# (possible after an instance spin-down) and requeued on next startup.
PROCESSING_STALE_AFTER_MINUTES=30


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json (Render log viewer) | console